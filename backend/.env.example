PORT=4000
# Use a random string of 32+ characters in production (e.g. `openssl rand -hex 32`).
# The server refuses to start in production with this placeholder.
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
DATABASE_PATH=./data/ssb.db
# Comma-separated list of allowed origins, or * for any.
# In production, list only your own web domains (e.g. https://ssbtour.com), or leave unset to allow none.
# The mobile app doesn't need CORS.
CORS_ORIGIN=*
# Number of reverse proxies in front of the API (e.g. 1 for Caddy or Nginx), so rate limits see each
# user's real IP. Leave unset if the API faces the internet directly. `true` is rejected (IP spoofing).
# TRUST_PROXY=1
# Seed demo accounts, promo codes and sample reviews (default: true in development, false in production).
# Never enable in production: the demo passwords are public in the README.
# SEED_DEMO_DATA=true
